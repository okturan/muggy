{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "muggy",
  "main": "src/index.js",
  "compatibility_date": "2026-08-15",
  "account_id": "1992595a6b0bebdbb4d076347609333d",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // Climatology cache. Ten years of archive data per location never changes,
  // so it is worth holding globally rather than per edge colo.
  "kv_namespaces": [
    { "binding": "NORMALS", "id": "036f4dd2a380465db4779137d5d7d2eb" }
  ],
  "observability": { "enabled": true }
}
